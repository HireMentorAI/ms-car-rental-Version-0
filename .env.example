# Required by the server-side enquiry route. Set the real value in .env.local
# for local development and in Vercel Project Settings for production.
WEB3FORMS_ACCESS_KEY=c13992d0-c95f-409c-ad9b-02a4ce47f891
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token


# Optional: whole-number passenger cap (1-100); defaults to 40.
MAX_PASSENGERS=40
